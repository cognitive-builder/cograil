# COGRAIL_OIDC_ALLOWED_DOMAINS=example.com
# COGRAIL_SESSION_SECRET=
# COGRAIL_OIDC_ID_CLAIM=email
# COGRAIL_OIDC_GROUPS_CLAIM=groups
