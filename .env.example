ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+asyncpg://cograil:cograil@localhost:5432/cograil
# Alembic connects as the owner; unset falls back to DATABASE_URL. See docs/deploy.md.
# MIGRATIONS_DATABASE_URL=postgresql+asyncpg://cograil:cograil@localhost:5432/cograil
COGRAIL_AUTH=dev
COGRAIL_DEV_PRINCIPAL=alice@example.com
COGRAIL_DEV_GROUPS=all-employees,finance
