# Sign-in for this pack: Microsoft Entra ID over OIDC (docs/auth.md, "Setting Up Entra ID").
# Settings come from the environment, never from workspace files, so this is a template of
# variable names with placeholders. Copy it to a real env file kept out of the repo.
COGRAIL_AUTH=oidc
COGRAIL_OIDC_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
COGRAIL_OIDC_CLIENT_ID=<application-client-id>
COGRAIL_OIDC_CLIENT_SECRET=<client-secret-from-your-secret-store>
COGRAIL_OIDC_ID_CLAIM=preferred_username
COGRAIL_OIDC_GROUPS_CLAIM=groups
COGRAIL_OIDC_ALLOWED_DOMAINS=example.com
COGRAIL_SESSION_SECRET=<generated-secret-of-at-least-32-characters>
COGRAIL_OIDC_REDIRECT_URL=https://cograil.example.com/auth/callback

# Connections (connections.yaml names these variables)
JIRA_CLIENT_ID=<jira-oauth-client-id>
JIRA_CLIENT_SECRET=<jira-oauth-client-secret>
NOTIFY_CLIENT_ID=<notify-oauth-client-id>
NOTIFY_CLIENT_SECRET=<notify-oauth-client-secret>
